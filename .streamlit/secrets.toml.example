# Copy this file to secrets.toml (local) or paste keys in
# Streamlit Cloud → App settings → Secrets
#
# REQUIRED on Streamlit Cloud so credentials survive restarts:
encryption_key = "change-me-to-a-long-random-passphrase"

# Optional: public URL of this app (used to build webhook links)
# public_url = "https://YOUR-APP.streamlit.app"
